      <aliases enabled='yes' />
      <column caption='Total Orders' datatype='integer' name='[Calculation_0323323176321024]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([order_id])' />
      </column>
      <column caption='Late Delivery Rate' datatype='real' default-format='p0.0%' name='[Calculation_0323323205636098]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [late_delivery] = &apos;Yes&apos; THEN 1 ELSE 0 END)/ COUNT([order_id])' />
      </column>
      <column caption='Avg Delay Days' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_0323323213647875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([delivery_delay_days])' />
      </column>
      <column caption='Avg Rating' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_0323323215634436]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([customer_rating])' />
      </column>
      <column caption='Return (%)' datatype='real' default-format='p0.0%' name='[Calculation_0323323217371141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [return_requested] = &apos;Yes&apos; THEN 1 ELSE 0 END) / COUNT([order_id])' />
      </column>
      <column caption='Network  Late Rate' datatype='real' default-format='N' name='[Calculation_0323323400790023]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED :SUM(IF [late_delivery] = &apos;Yes&apos; THEN 1 ELSE 0 END)}/ {FIXED : COUNT([order_id])}' />
      </column>
      <column caption='Late Rate vs Network Gap' datatype='real' default-format='N' name='[Calculation_0323323401547784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_0323323403448329] - [Calculation_0323323400790023]) * 100' />
      </column>
      <column caption='Warehouse Late Rate' datatype='real' default-format='N' name='[Calculation_0323323403448329]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [warehouse_city]: SUM(IF [late_delivery] = &apos;Yes&apos; then 1 ELSE 0 END)} / {FIXED [warehouse_city]: COUNT([order_id])}' />
      </column>
      <column caption='Cost Per Kg.' datatype='real' default-format='c&quot;$&quot;#,##0.0;(&quot;$&quot;#,##0.0)' name='[Calculation_0323323546644493]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[shipping_cost_usd] / [product_weight_kg]' />
      </column>
