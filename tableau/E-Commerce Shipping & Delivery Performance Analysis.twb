              <calculation class='tableau' formula='{FIXED :SUM(IF [late_delivery] = &apos;Yes&apos; THEN 1 ELSE 0 END)}/ {FIXED : COUNT([order_id])}' />
            </column>
            <column caption='Late Rate vs Network Gap' datatype='real' default-format='N' name='[Calculation_0323323401547784]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Calculation_0323323403448329] - [Calculation_0323323400790023]) * 100' />
