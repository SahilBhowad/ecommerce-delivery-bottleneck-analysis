      </style>
      <size maxheight='768' maxwidth='1366' minheight='768' minwidth='1366' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone forceUpdate='true' h='9115' id='3' type-v2='text' w='100000' x='0' y='0'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='18'>  CUSTOMER IMPACT &amp; ACTIONS</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
            <format attr='border-style' value='none' />
            <format attr='border-width' value='0' />
            <format attr='background-color' value='#1f2a44' />
          </zone-style>
        </zone>
        <zone h='28646' id='4' name='Avg Rating by Delivery Performance' w='49268' x='366' y='10417'>
          <zone-style>
            <format attr='border-color' value='#d4d4d4' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='padding-top' value='4' />
          </zone-style>
        </zone>
        <zone h='28516' id='5' name='Return Rate by Delivery Performance (2)' w='49268' x='50366' y='10417'>
          <zone-style>
            <format attr='border-color' value='#d4d4d4' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='padding-top' value='4' />
          </zone-style>
        </zone>
        <zone h='28646' id='6' name='Shipping Cost per Kg by Method' w='49268' x='366' y='40365'>
          <zone-style>
            <format attr='border-color' value='#d4d4d4' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='padding' value='0' />
            <format attr='padding-top' value='4' />
            <format attr='padding-bottom' value='4' />
          </zone-style>
        </zone>
        <zone h='28516' id='7' name='Avg Rating by Delivery Attempts' w='49268' x='50366' y='40365'>
          <zone-style>
            <format attr='border-color' value='#d4d4d4' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='padding' value='3' />
            <format attr='padding-top' value='4' />
            <format attr='padding-right' value='6' />
            <format attr='padding-bottom' value='4' />
            <format attr='padding-left' value='6' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='28516' id='8' type-v2='text' w='49268' x='366' y='70313'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='11'>Key Insights</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>56.3% of orders arrive late.</run>
            <run fontcolor='#000000'> Only about 1 in 3 arrives on time, so this is a network-wide problem, not a few bad cases.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>Delays start in the warehouse.</run>
            <run fontcolor='#000000'> Delayed orders spend 16.6 hrs in processing vs 8.8 hrs for early orders.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>Priority matters most.</run>
            <run fontcolor='#000000'> Low-priority orders are late 81.7% of the time vs 25.7% for Urgent.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>Customers feel it.</run>
            <run fontcolor='#000000'> Delayed orders average  2.7 stars vs  4.2 for on-time, and 23.3% of them are returned.</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#d4d4d4' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='padding-top' value='6' />
            <format attr='padding-left' value='4' />
          </zone-style>
        </zone>
        <zone forceUpdate='true' h='28516' id='9' type-v2='text' w='49268' x='50366' y='70313'>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='11'>Recommended Actions :</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>Audit the Sydney warehouse first.</run>
            <run fontcolor='#000000'> It has the biggest gap vs the network (+1.26 pp).</run>
            <run bold='true' fontcolor='#000000'> Fix the GlobalExpress + International route.</run>
            <run fontcolor='#000000'> It’s the weakest carrier-method pair, and   International is also the most expensive method per kg.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>Cut warehouse processing time.</run>
            <run fontcolor='#000000'> Reducing the hours before dispatch is the highest-leverage fix.</run>
            <run>Æ&#10;</run>
            <run bold='true' fontcolor='#000000'>Extend priority handling to Low and Normal orders.</run>
            <run fontcolor='#000000'> They are late 63-82% of the time.</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#d4d4d4' />
            <format attr='border-style' value='solid' />
            <format attr='border-width' value='1' />
            <format attr='padding-left' value='4' />
          </zone-style>
        </zone>
        <zone h='3906' id='10' type-v2='dashboard-object' w='3660' x='91288' y='2604'>
